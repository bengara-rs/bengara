#[bengara::test]
async fn トップページが表示される() {
    // 画面に出るのは `APP_NAME`。`.env` の値によらないよう、設定から読んで比べる。
    let name = bengara::config::<bengara::AppConfig>().name.clone();
    get("/").await.assert_ok().assert_see(&name);
}

#[bengara::test]
async fn 生存確認が応答する() {
    get("/up").await.assert_ok().assert_see("ok");
}

#[bengara::test]
async fn 無いページは404になる() {
    get("/no-such-page").await.assert_status(404);
}
