APP_NAME={{name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# セッション・署名付き URL・暗号化に使う鍵。`cargo artisan key:generate` で作ります。
# **64 文字以上が必要です。** 作り直すと、いまのセッションと暗号文は読めなくなります。
APP_KEY=

# セッションの置き場所（file / memory）と、放っておいて消えるまでの分
SESSION_DRIVER=file
SESSION_LIFETIME=120

# データベース。sqlite / mysql / mariadb / pgsql から選びます。
# **選んだドライバの Cargo の機能フラグが必要です**（Cargo.toml の bengara の features）。
#   sqlite -> "sqlite" / mysql・mariadb -> "mysql" / pgsql -> "postgres"
# sqlite ではファイルは無ければ作られます。相対パスはプロジェクト直下から見ます。
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# mysql / pgsql のときに使います。
# DB_PORT を空にすると 3306（mysql）/ 5432（pgsql）を使います。
# DB_HOST=127.0.0.1
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# 同時に張る接続の数の上限。既定は 5 です。
# DB_MAX_CONNECTIONS=5
# 接続文字列でまとめて書くこともできます（**他の値より優先します**）。
# DB_URL=

# テストで使うデータベース。開発用とは分けます（:memory: ならディスクに残りません）。
# **mysql / pgsql では必ず別のデータベース名を書いてください。**
# テストは表を全部消すので、書かないとテストが始まりません。
DB_TEST_DATABASE=:memory:

APP_HOST=127.0.0.1
APP_PORT=8000

# ログの細かさ（trace / debug / info / warn / error）
# RUST_LOG=info

# パスワードの変換の繰り返し回数。既定は 120,000 です。
# リリースビルドで約 0.23 秒、デバッグビルドでは約 3.6 秒かかります。
# 開発中にログインが遅いと感じたら、下の行を有効にして下げてください。
# **本番では消すか、120000 以上にしてください。**
# HASH_ITERATIONS=10000

# キャッシュの置き場所（file / memory）
CACHE_DRIVER=file

# メールの送り先（log / array / smtp）。log は storage/logs/mail.log に書き出します。
# **smtp には Cargo の機能フラグ "mail" が必要です。**
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME={{name}}

# smtp のときに使います。MAIL_PORT を空にすると、暗号化に合わせて
# 465（tls）/ 587（starttls）/ 25（none）を使います。
# MAIL_HOST=127.0.0.1
# MAIL_PORT=
# MAIL_ENCRYPTION=starttls
# MAIL_USERNAME=
# MAIL_PASSWORD=
# EHLO で名乗る名前。空なら localhost と名乗ります。
# MAIL_EHLO_NAME=
# 返事を待つ上限の秒数。
# MAIL_TIMEOUT=10

# 画面の言語（resources/lang/*.toml の名前）
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

# storage/ の場所。**絶対パスのみ。** 空ならプロジェクト直下の storage/ を使います。
# プロセスを2つ以上動かすときは、全プロセスで同じ場所を指してください。
# APP_STORAGE_PATH=

# 停止の合図を受けてから、処理中のリクエストを待つ上限の秒数（0 は無制限）
APP_SHUTDOWN_TIMEOUT=30

# 信頼する逆プロキシのアドレス（カンマ区切り。`*` ですべて信頼）。
# **指定したときだけ** X-Forwarded-For と X-Real-IP を見ます。
# 空のままなら、どちらのヘッダーも見ずに接続元のアドレスで数えます。
# 前に nginx などを置くときだけ設定してください。範囲指定（CIDR）は書けません。
# TRUSTED_PROXIES=
