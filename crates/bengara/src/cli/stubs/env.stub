APP_NAME={{name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# セッション・署名付き URL・暗号化に使う鍵。`cargo artisan key:generate` で作ります。
# **64 文字以上が必要です。** 作り直すと、いまのセッションと暗号文は読めなくなります。
APP_KEY=

# セッションの置き場所（file / memory）と、放っておいて消えるまでの分
SESSION_DRIVER=file
SESSION_LIFETIME=120

# データベース。sqlite / mysql / mariadb / pgsql から選びます。
# **選んだドライバの Cargo の機能フラグが必要です**（Cargo.toml の bengara の features）。
#   sqlite -> "sqlite" / mysql・mariadb -> "mysql" / pgsql -> "postgres"
# sqlite ではファイルは無ければ作られます。相対パスはプロジェクト直下から見ます。
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# mysql / pgsql のときに使います。
# DB_PORT を空にすると 3306（mysql）/ 5432（pgsql）を使います。
# **`#` を含む値は必ず引用符で囲んでください**（DB_PASSWORD="p#ss"）。
# 囲まないと `#` より前までが値になります（DB_PASSWORD=p#ss は p になります）。
# DB_HOST=127.0.0.1
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# 同時に張る接続の数の上限。既定は 5 です。どの接続にも同じ値を使います。
# DB_MAX_CONNECTIONS=5
# 接続文字列でまとめて書くこともできます。**DB_CONNECTION で選んだ接続にだけ**
# 効き、DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD より優先します。
# DB_URL=

# テストで使うデータベース。開発用とは分けます（:memory: ならディスクに残りません）。
# **mysql / pgsql では必ず別のデータベース名を書いてください。**
# テストは表を全部消すので、書かないとテストが始まりません。
DB_TEST_DATABASE=:memory:

APP_HOST=127.0.0.1
APP_PORT=8000

# ログの細かさ（trace / debug / info / warn / error / off）
# RUST_LOG=info

# パスワードの変換の繰り返し回数。既定は 240,000 です。
# リリースビルドで約 0.2 秒、デバッグビルドでは約 4 秒かかります。
# 開発中にログインが遅いと感じたら、下の行を有効にして下げてください。
# **本番では消すか、240000 以上にしてください。**
# HASH_ITERATIONS=10000

# パスワードの変換の方式（pbkdf2 / argon2id）。既定は pbkdf2 です。
# **argon2id には Cargo の機能フラグ "argon2" が必要です。**
# 方式を替えても、前の方式で作った値で照合でき、ログインのついでに作り直します。
# HASH_DRIVER=pbkdf2

# キャッシュの置き場所（file / memory）
CACHE_DRIVER=file

# メールの送り先（log / array / smtp）。log は storage/logs/mail.log に書き出します。
# **smtp には Cargo の機能フラグ "mail" が必要です。**
MAIL_MAILER=log
# 差出人（Laravel と同じ名前）。前からの MAIL_FROM も読みます（MAIL_FROM_ADDRESS が先）。
MAIL_FROM_ADDRESS=noreply@example.com
# "${APP_NAME}" は上の APP_NAME の値になります。
MAIL_FROM_NAME="${APP_NAME}"

# smtp のときに使います。MAIL_PORT を空にすると、暗号化に合わせて
# 465（tls）/ 587（starttls）/ 25（none）を使います。
# 暗号化なしにするときは none と書きます（空にすると starttls になります）。
# tls は 465 番なら最初から暗号化し、それ以外の番号では STARTTLS を使います。
# Laravel 11 の MAIL_SCHEME（smtp / smtps）も読めます。書けば MAIL_ENCRYPTION より先に見ます。
# smtps は最初から暗号化、smtp は 465 番なら最初から暗号化・ほかは STARTTLS です。
# MAIL_USERNAME と MAIL_PASSWORD の null は空と同じです。
# MAIL_HOST=127.0.0.1
# MAIL_PORT=
# MAIL_ENCRYPTION=starttls
# MAIL_SCHEME=
# MAIL_USERNAME=
# MAIL_PASSWORD=
# EHLO で名乗る名前。空なら [127.0.0.1]（アドレスそのもの）と名乗ります。
# 断るサーバーがあるので、外へ送るときは自分のホスト名（mail.example.com など）を書いてください。
# MAIL_EHLO_NAME=
# 返事を待つ上限の秒数。
# MAIL_TIMEOUT=10

# 画面の言語（resources/lang/*.toml の名前）
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja

# storage/ の場所。**絶対パスのみ。** 空ならプロジェクト直下の storage/ を使います。
# プロセスを2つ以上動かすときは、全プロセスで同じ場所を指してください。
# APP_STORAGE_PATH=

# 既定のファイル置き場（local / public）。`Storage::put` などが使います。既定は local です。
# STORAGE_DISK=local

# 停止の合図を受けてから、処理中のリクエストを待つ上限の秒数（0 は無制限）
APP_SHUTDOWN_TIMEOUT=30

# 受け取る本文の上限（バイト）。既定は 2 MiB（2097152）です。超えると 413 を返します。
# ルートごとに変えるときは `.max_body(n)` を使います。全部を読むルートは 30 秒で
# 読み終える必要があるので、大きなファイルは `.stream_body()` のルートで受けてください。
# 前段に nginx を置くときは、nginx の上限（client_max_body_size）も合わせてください。
# APP_MAX_BODY_BYTES=2097152

# 信頼する逆プロキシのアドレス（カンマ区切り）。`*` は接続元を信頼します（Laravel の '*' と同じ）。
# **指定したときだけ** X-Forwarded-For と X-Real-IP を見ます。
# 空のままなら、どちらのヘッダーも見ずに接続元のアドレスで数えます。
# 前に nginx などを置くときだけ設定してください。範囲指定（CIDR）は書けません。
# TRUSTED_PROXIES=

# WebSocket のチャンネルへの配信の送り方（memory / database）。既定は memory です。
# **Cargo の機能フラグ "websocket" が必要です。**
# 定期処理やキューなど、サーバーではないプロセスから送るときと、サーバーが
# 2 つ以上のときは database にして、マイグレーションで表（broadcasts）を作ります。
# BROADCAST_CONNECTION=memory
# 同時につなげる WebSocket の数の上限。既定は 10000 です。
# WEBSOCKET_MAX_CONNECTIONS=10000
