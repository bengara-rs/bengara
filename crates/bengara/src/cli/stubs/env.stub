APP_NAME={{name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# セッションと署名付き URL の署名に使う鍵。`cargo artisan key:generate` で作ります。
APP_KEY=

# セッションの置き場所（file / memory）と、放っておいて消えるまでの分
SESSION_DRIVER=file
SESSION_LIFETIME=120

APP_HOST=127.0.0.1
APP_PORT=8000

# ログの細かさ（trace / debug / info / warn / error）
# RUST_LOG=info
