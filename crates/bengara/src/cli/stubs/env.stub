APP_NAME={{name}}
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# セッションと署名付き URL の署名に使う鍵。`cargo artisan key:generate` で作ります。
APP_KEY=

# セッションの置き場所（file / memory）と、放っておいて消えるまでの分
SESSION_DRIVER=file
SESSION_LIFETIME=120

# データベース。いまつなげるのは sqlite だけです。
# ファイルは無ければ作られます。相対パスはプロジェクト直下から見ます。
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# テストで使うデータベース。開発用とは分けます（:memory: ならディスクに残りません）
DB_TEST_DATABASE=:memory:

APP_HOST=127.0.0.1
APP_PORT=8000

# ログの細かさ（trace / debug / info / warn / error）
# RUST_LOG=info

# パスワードの変換の繰り返し回数。既定は 120,000 です。
# リリースビルドで約 0.23 秒、デバッグビルドでは約 3.6 秒かかります。
# 開発中にログインが遅いと感じたら、下の行を有効にして下げてください。
# **本番では消すか、120000 以上にしてください。**
# HASH_ITERATIONS=10000
